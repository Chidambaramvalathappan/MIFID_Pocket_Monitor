<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ow_terminal_background"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Top Status Bar: Signal Bars + Carrier Icon + Battery + Page Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Signal Bars -->
        <TextView
            android:id="@+id/tv_header_signal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[||||]"
            android:textColor="@color/ow_success"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Carrier Logo -->
        <ImageView
            android:id="@+id/iv_carrier_logo"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:contentDescription="Carrier"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_carrier_airtel" />

        <!-- Flexible Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Top Battery Indicator -->
        <TextView
            android:id="@+id/tv_header_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:text="100%"
            android:textColor="@color/ow_success"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Page Indicator (e.g. 1/2) -->
        <TextView
            android:id="@+id/tv_header_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/2"
            android:textColor="@color/ow_text_secondary"
            android:textSize="9sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- Subtitle / Mode Header -->
    <TextView
        android:id="@+id/tv_header_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:text="MODEM DASHBOARD"
        android:textColor="@color/ow_warning"
        android:textSize="8sp"
        android:typeface="monospace" />

    <!-- Thin Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="2dp"
        android:background="@color/ow_border" />

    <!-- CONTAINER 1: Screen 1 — Compact Status Boxes Layout -->
    <LinearLayout
        android:id="@+id/layout_screen1_boxes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- BOX A: CELLULAR NETWORK (Top Box) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_status_tile"
            android:orientation="vertical"
            android:paddingBottom="1dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingTop="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_box_cell_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="AIR 4G"
                    android:textColor="@color/ow_accent"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_box_cell_rsrp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-79 dBm"
                    android:textColor="@color/ow_text_primary"
                    android:textSize="8sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tv_box_cell_roam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROAM NO"
                    android:textColor="@color/ow_text_secondary"
                    android:textSize="8sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOX B: HOTSPOT (Wi-Fi State & Credentials) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_status_tile"
            android:orientation="vertical"
            android:paddingBottom="1dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingTop="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_box_hotspot_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HOTSPOT ON"
                    android:textColor="@color/ow_success"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tv_box_hotspot_clients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLIENTS 00"
                    android:textColor="@color/ow_warning"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <!-- Hotspot SSID -->
            <TextView
                android:id="@+id/tv_box_hotspot_ssid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ID: --"
                android:textColor="@color/ow_text_primary"
                android:textSize="7sp"
                android:typeface="monospace" />

            <!-- Hotspot Password -->
            <TextView
                android:id="@+id/tv_box_hotspot_pwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="PW: --"
                android:textColor="@color/ow_text_secondary"
                android:textSize="7sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- BOX C: MOBILE DATA (DL & UL session traffic) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_status_tile"
            android:orientation="horizontal"
            android:paddingBottom="2dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"
                android:text="DATA"
                android:textColor="@color/ow_accent"
                android:textSize="8sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tv_box_data_traffic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="DL 1.5MB  UL 7.0MB"
                android:textColor="@color/ow_text_primary"
                android:textSize="7sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- BOX D: BATTERY (Level & Charging Status) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/tv_box_battery_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BAT 100%"
                android:textColor="@color/ow_success"
                android:textSize="8sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tv_box_battery_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHARGING"
                android:textColor="@color/ow_text_primary"
                android:textSize="8sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTAINER 2: Screen 2 — Detailed Diagnostics Lines -->
    <LinearLayout
        android:id="@+id/layout_screen2_lines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_line3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_line4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_line5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_line6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_secondary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_line7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_success"
            android:textSize="8sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- CONTAINER 3: Screen 3 — Hotspot Connected Device Details -->
    <LinearLayout
        android:id="@+id/layout_screen3_clients"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Title / Count Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_status_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HOTSPOT CLIENTS"
                android:textColor="@color/ow_accent"
                android:textSize="8sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tv_screen3_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00"
                android:textColor="@color/ow_success"
                android:textSize="8sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Connected Device Box -->
        <LinearLayout
            android:id="@+id/box_client_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_tile"
            android:orientation="vertical"
            android:paddingBottom="2dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingTop="2dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_client_index"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CLIENT 1 OF 1"
                android:textColor="@color/ow_text_secondary"
                android:textSize="7sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tv_client_hostname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="HOST: UNKNOWN"
                android:textColor="@color/ow_text_primary"
                android:textSize="8sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tv_client_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="IP: 192.168.100.---"
                android:textColor="@color/ow_accent"
                android:textSize="8sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tv_client_mac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MAC: --:--:--:--:--:--"
                android:textColor="@color/ow_text_secondary"
                android:textSize="7sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Empty state message if no clients connected -->
        <TextView
            android:id="@+id/tv_client_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="NO CLIENTS\nCONNECTED"
            android:textColor="@color/ow_text_secondary"
            android:textSize="8sp"
            android:typeface="monospace"
            android:visibility="gone" />
    </LinearLayout>

    <!-- CONTAINER 4: Screen 4 — Hardware & System Diagnostics Lines -->
    <LinearLayout
        android:id="@+id/layout_screen4_system"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_sys_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_sys_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_sys_line3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_sys_line4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_sys_line5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_primary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_sys_line6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_text_secondary"
            android:textSize="8sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_sys_line7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ow_success"
            android:textSize="8sp"
            android:typeface="monospace" />
    </LinearLayout>

</LinearLayout>